/*
 * freesense-fleet-poll: started every minute by cron; checks each box
 * every poll_interval seconds (10 to 60) within the minute. Reads each
 * managed box's status through the tunnel (certificate pinned) and updates
 * the box list:
 * online, degraded after 3 missed polls, offline after 10. A box whose
 * configuration changed (and has been quiet for 5 minutes) is backed up.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

if (!fleet_ctl_settings()['enable'] || !is_file(FLEET_DATA . '/fleet.db')) {
	exit(0);
}
$lock = fopen('/var/run/fleet-poll.lock', 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}
/*
 * cron starts this every minute; it checks every firewall every
 * poll_interval seconds until the minute is nearly over. On-change backups
 * are looked at once per run.
 */
$interval = fleet_ctl_settings()['poll_interval'];
$until = time() + 55;
$first = true;
do {
	$round = time();
	$due = array();
	foreach (fleet_db()->query('SELECT * FROM boxes ORDER BY host_no')->fetchAll() as $box) {
		if ((fleet_poll_box($box, time(), $interval) === 'online') && $first) {
			/* Now and then: is an update available? (the box checks its own channel) */
			$info = fleet_update_info($box);
			if (($box['role'] === 'managed' || $box['role'] === 'monitor') && (($info === null) || (time() - (int)$info['checked'] >= 3600 * fleet_opt('update_check_hours')))) {
				fleet_update_check($box);
			}
			/* A changed configuration that has been quiet for a while gets a backup. */
			$status = json_decode((string)fleet_box_get($box['node_id'])['status'], true) ?: array();
			if (fleet_backup_due(fleet_backup_latest($box['node_id']), $status, time())) {
				$due[] = $box;
			}
		}
	}
	if (!empty($due)) {
		fleet_backup_many($due, 'change', 'system');
	}
	if ($first) {
		/* Rollouts move on once a minute: the next firewall when its ring's window is open. */
		fleet_rollouts_tick(time());
	}
	$first = false;
	$next = $round + $interval;
	if ($next < $until) {
		sleep(max(0, $next - time()));
	}
} while ($next < $until);
