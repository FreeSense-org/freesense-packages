/*
 * freesense-fleet-poll: run every minute by cron. Reads each managed box's
 * status through the tunnel (certificate pinned) and updates the box list:
 * online, degraded after 3 missed polls, offline after 10.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

if (!fleet_ctl_settings()['enable'] || !is_file(FLEET_DATA . '/fleet.db')) {
	exit(0);
}
$lock = fopen('/var/run/fleet-poll.lock', 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}
foreach (fleet_db()->query('SELECT * FROM boxes ORDER BY host_no')->fetchAll() as $box) {
	fleet_poll_box($box, time());
}
