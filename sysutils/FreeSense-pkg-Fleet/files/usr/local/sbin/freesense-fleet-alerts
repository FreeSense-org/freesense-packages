/*
 * freesense-fleet-alerts: sends Fleet's alerts and the daily reports (cron, every minute).
 * Apart from the status poll so that a webhook that does not answer cannot hold up monitoring,
 * schedules or rollouts; it has its own lock and stops after FLEET_ALERT_BUDGET seconds.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

if (!fleet_ctl_settings()['enable'] || !is_file(FLEET_DATA . '/fleet.db')) {
	exit(0);
}
$lock = fopen('/var/run/fleet-alerts.lock', 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}
foreach (array('deliver' => function () { fleet_alerts_deliver(time()); }, 'reports' => function () { fleet_alerts_reports(time()); }) as $stage => $run) {
	try {
		$run();
	} catch (Throwable $e) {
		error_log("Fleet alerts ({$stage}) failed: " . $e->getMessage());
	}
}
