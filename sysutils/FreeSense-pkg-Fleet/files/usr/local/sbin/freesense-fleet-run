/*
 * freesense-fleet-run: runs an operation in the background, reporting
 * each step to it (Activity and the tiles show the progress).
 *   freesense-fleet-run reboot-group <op id>
 *     Reboots the operation's firewalls one at a time: the next starts
 *     only when the one before is back online (the status poll decides
 *     that from its boot time). The first failure stops it; the rest are
 *     skipped and say why.
 *   freesense-fleet-run update-group <op id>
 *     The same one at a time for system updates: the next starts when the
 *     one before is updated and has stayed healthy; a rollback stops it.
 *   freesense-fleet-run connections <op id>
 *     Sets each firewall's connection to what it should use (path or tunnel)
 *   freesense-fleet-run template <op id> <template id>
 *     Applies a template to the operation's firewalls one after another
 *     (each takes seconds). A failure on one firewall does not stop the
 *     others.
 *   freesense-fleet-run users <op id>
 *     Syncs Fleet users and groups to the operation's firewalls one after
 *     another; a failure on one does not stop the others.
 *   freesense-fleet-run restore <op id> <backup id>
 *     Restores a backup onto its firewall (safety backup, snapshot,
 *     restore, keep it only when the firewall still answers).
 * Started by the WebUI; one runner per operation.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

$cmd = $argv[1] ?? '';
$op_id = (int)($argv[2] ?? 0);
if (!in_array($cmd, array('reboot-group', 'update-group', 'restore', 'template', 'users', 'connections'), true) || ($op_id <= 0)) {
	echo "usage: freesense-fleet-run reboot-group|update-group <op id> | restore <op id> <backup id> | template <op id> <template id>\n";
	exit(64);
}
$lock = fopen("/var/run/fleet-op-{$op_id}.lock", 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}

if ($cmd === 'users') {
	foreach (fleet_op_tasks($op_id) as $task) {
		if ($task['state'] !== 'queued') {
			continue;
		}
		$box = fleet_box_get((string)$task['node_id']);
		if ($box === null) {
			fleet_op_set((int)$task['id'], 'failed', 'The firewall is gone.');
			fleet_op_group_update($op_id);
			continue;
		}
		fleet_op_set((int)$task['id'], 'running', 'Starting', 0);
		fleet_op_group_update($op_id);
		try {
			$text = fleet_users_sync_box($box, (string)$task['who'], function (string $text, int $percent) use ($task): void {
				fleet_op_set((int)$task['id'], 'running', $text, $percent);
			});
			fleet_op_set((int)$task['id'], 'done', $text);
		} catch (RuntimeException $e) {
			fleet_op_set((int)$task['id'], 'failed', $e->getMessage());
		}
		fleet_op_group_update($op_id);
	}
	exit(0);
}

if ($cmd === 'connections') {
	$overview = fleet_conn_overview();
	foreach (fleet_op_tasks($op_id) as $task) {
		if ($task['state'] !== 'queued') {
			continue;
		}
		$box = fleet_box_get((string)$task['node_id']);
		if (($box === null) || !isset($overview[$box['node_id']])) {
			fleet_op_set((int)$task['id'], 'failed', 'The firewall is gone.');
			fleet_op_group_update($op_id);
			continue;
		}
		fleet_op_set((int)$task['id'], 'running', 'Starting', 0);
		fleet_op_group_update($op_id);
		try {
			$text = fleet_conn_apply_box($box, $overview[$box['node_id']]['want'], (string)$task['who'], function (string $text, int $percent) use ($task): void {
				fleet_op_set((int)$task['id'], 'running', $text, $percent);
			});
			fleet_op_set((int)$task['id'], 'done', $text);
		} catch (RuntimeException $e) {
			fleet_op_set((int)$task['id'], 'failed', $e->getMessage());
		}
		fleet_op_group_update($op_id);
	}
	exit(0);
}

if ($cmd === 'template') {
	$t = fleet_template_get((int)($argv[3] ?? 0));
	foreach (fleet_op_tasks($op_id) as $task) {
		if ($task['state'] !== 'queued') {
			continue;
		}
		$box = fleet_box_get((string)$task['node_id']);
		if (($t === null) || ($box === null)) {
			fleet_op_set((int)$task['id'], 'failed', 'The template or firewall is gone.');
			fleet_op_group_update($op_id);
			continue;
		}
		fleet_op_set((int)$task['id'], 'running', 'Starting', 0);
		fleet_op_group_update($op_id);
		try {
			$text = fleet_template_apply_box($t, $box, (string)$task['who'], function (string $text, int $percent) use ($task): void {
				fleet_op_set((int)$task['id'], 'running', $text, $percent);
			});
			fleet_op_set((int)$task['id'], 'done', $text);
		} catch (RuntimeException $e) {
			fleet_op_set((int)$task['id'], 'failed', $e->getMessage());
		}
		fleet_op_group_update($op_id);
	}
	exit(0);
}

if ($cmd === 'restore') {
	$op = fleet_db()->query('SELECT * FROM ops WHERE id = ' . $op_id)->fetch();
	$box = $op ? fleet_box_get((string)$op['node_id']) : null;
	$row = fleet_backup_get((int)($argv[3] ?? 0));
	if (($box === null) || ($row === null) || ($row['node_id'] !== $box['node_id'])) {
		fleet_op_set($op_id, 'failed', 'That backup does not belong to this firewall.');
		exit(1);
	}
	try {
		$text = fleet_backup_restore($box, $row, (string)$op['who'], null, function (string $text, int $percent) use ($op_id): void {
			fleet_op_set($op_id, 'running', $text, $percent);
		});
		fleet_op_set($op_id, 'done', $text);
		/* The dashboard shows the restored configuration at once, not after the next check. */
		fleet_poll_box(fleet_box_get($box['node_id']), time());
	} catch (RuntimeException $e) {
		fleet_op_set($op_id, 'failed', $e->getMessage());
	}
	exit(0);
}

$ha_since = array();
while (true) {
	$tasks = fleet_op_tasks($op_id);
	$step = fleet_rolling_next(array_column($tasks, 'state'));
	if ($step['do'] === 'wait') {
		sleep(5);
		continue;
	}
	if ($step['do'] === 'stop') {
		foreach ($tasks as $t) {
			if ($t['state'] === 'queued') {
				fleet_op_set((int)$t['id'], 'skipped', 'Skipped: stopped after a failure');
			}
		}
		break;
	}
	if ($step['do'] === 'done') {
		break;
	}
	/* An HA pair: of the firewalls still waiting, a pair's BACKUP before its MASTER (decided now, not at the start). */
	$queued = array_filter($tasks, function ($x) { return $x['state'] === 'queued'; });
	$t = $tasks[array_key_first(fleet_ha_sort(array_combine(array_keys($queued), array_column($queued, 'node_id'))))];
	$box = fleet_box_get((string)$t['node_id']);
	/* An HA pair: never both at once; wait until the partner is back and the pair is healthy. */
	$ha = fleet_ha_wait((string)$t['node_id']);
	if ($ha !== null) {
		$ha_since[$t['id']] = $ha_since[$t['id']] ?? time();
		if (time() - $ha_since[$t['id']] < FLEET_HA_WAIT) {
			fleet_op_set((int)$t['id'], 'queued', $ha);
			sleep(15);
			continue;
		}
		fleet_op_set((int)$t['id'], 'failed', $ha . ' for ' . (FLEET_HA_WAIT / 60) . ' minutes; not started.');
		fleet_op_group_update($op_id);
		continue;
	}
	try {
		if ($box === null) {
			throw new RuntimeException('Not in the fleet any more.');
		}
		if ($cmd === 'update-group') {
			fleet_box_update($box, (string)$t['who'], (int)$t['id']);
		} else {
			fleet_box_reboot($box, (string)$t['who'], (int)$t['id']);
		}
	} catch (RuntimeException $e) {
		fleet_op_set((int)$t['id'], 'failed', (($cmd === 'update-group') ? 'Update refused: ' : 'Reboot refused: ') . $e->getMessage());
	}
	fleet_op_group_update($op_id);
}
fleet_op_group_update($op_id);
exit(0);
