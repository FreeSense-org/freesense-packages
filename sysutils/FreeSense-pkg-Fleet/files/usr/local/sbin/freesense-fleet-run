/*
 * freesense-fleet-run: runs an operation in the background, reporting
 * each step to it (Activity and the tiles show the progress).
 *   freesense-fleet-run reboot-group <op id>
 *     Reboots the operation's firewalls one at a time: the next starts
 *     only when the one before is back online (the status poll decides
 *     that from its boot time). The first failure stops it; the rest are
 *     skipped and say why.
 *   freesense-fleet-run update-group <op id>
 *     The same one at a time for system updates: the next starts when the
 *     one before is updated and has stayed healthy; a rollback stops it.
 *   freesense-fleet-run restore <op id> <backup id>
 *     Restores a backup onto its firewall (safety backup, snapshot,
 *     restore, keep it only when the firewall still answers).
 * Started by the WebUI; one runner per operation.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

$cmd = $argv[1] ?? '';
$op_id = (int)($argv[2] ?? 0);
if (!in_array($cmd, array('reboot-group', 'update-group', 'restore'), true) || ($op_id <= 0)) {
	echo "usage: freesense-fleet-run reboot-group|update-group <op id> | restore <op id> <backup id>\n";
	exit(64);
}
$lock = fopen("/var/run/fleet-op-{$op_id}.lock", 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}

if ($cmd === 'restore') {
	$op = fleet_db()->query('SELECT * FROM ops WHERE id = ' . $op_id)->fetch();
	$box = $op ? fleet_box_get((string)$op['node_id']) : null;
	$row = fleet_backup_get((int)($argv[3] ?? 0));
	if (($box === null) || ($row === null) || ($row['node_id'] !== $box['node_id'])) {
		fleet_op_set($op_id, 'failed', 'That backup does not belong to this firewall.');
		exit(1);
	}
	try {
		$text = fleet_backup_restore($box, $row, (string)$op['who'], null, function (string $text, int $percent) use ($op_id): void {
			fleet_op_set($op_id, 'running', $text, $percent);
		});
		fleet_op_set($op_id, 'done', $text);
		/* The dashboard shows the restored configuration at once, not after the next check. */
		fleet_poll_box(fleet_box_get($box['node_id']), time());
	} catch (RuntimeException $e) {
		fleet_op_set($op_id, 'failed', $e->getMessage());
	}
	exit(0);
}

while (true) {
	$tasks = fleet_op_tasks($op_id);
	$step = fleet_rolling_next(array_column($tasks, 'state'));
	if ($step['do'] === 'wait') {
		sleep(5);
		continue;
	}
	if ($step['do'] === 'stop') {
		foreach ($tasks as $t) {
			if ($t['state'] === 'queued') {
				fleet_op_set((int)$t['id'], 'skipped', 'Skipped: stopped after a failure');
			}
		}
		break;
	}
	if ($step['do'] === 'done') {
		break;
	}
	$t = $tasks[$step['index']];
	$box = fleet_box_get((string)$t['node_id']);
	try {
		if ($box === null) {
			throw new RuntimeException('Not in the fleet any more.');
		}
		if ($cmd === 'update-group') {
			fleet_box_update($box, (string)$t['who'], (int)$t['id']);
		} else {
			fleet_box_reboot($box, (string)$t['who'], (int)$t['id']);
		}
	} catch (RuntimeException $e) {
		fleet_op_set((int)$t['id'], 'failed', (($cmd === 'update-group') ? 'Update refused: ' : 'Reboot refused: ') . $e->getMessage());
	}
	fleet_op_group_update($op_id);
}
fleet_op_group_update($op_id);
exit(0);
