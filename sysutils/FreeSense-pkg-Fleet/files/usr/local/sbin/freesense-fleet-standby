/*
 * Run every minute by cron on a standby controller: fetch a newer copy
 * from the primary, and take over when that is set to happen
 * automatically and the primary has been silent long enough.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet.inc');

$lock = fopen('/var/run/fleet-standby.lock', 'c');
if (!flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}
try {
	echo fleet_standby_tick(time()), "\n";
} catch (Throwable $e) {
	logger(LOG_ERR, 'FreeSense Fleet standby: ' . $e->getMessage());
	exit(1);
}
