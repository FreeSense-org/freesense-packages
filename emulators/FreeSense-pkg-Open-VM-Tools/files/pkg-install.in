#!/bin/sh

# The cloud image already carries the VMware tools and the QEMU guest agent, so
# this optional package is for standard installs. It is refused on the cloud
# image with a plain reason. A copy that is already installed may still be
# updated or reinstalled.
if [ "${2}" = "PRE-INSTALL" ]; then
	if [ -x "${PKG_ROOTDIR}/usr/local/sbin/freesense-cloud-init" ] && [ ! -f "${PKG_ROOTDIR}/usr/local/pkg/open-vm-tools.xml" ]; then
		echo "This is the FreeSense cloud image: it already includes the VMware tools." >&2
		echo "This package is for standard installs; nothing was installed." >&2
		exit 1
	fi
	exit 0
fi

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

${PKG_ROOTDIR}/usr/local/bin/php -f ${PKG_ROOTDIR}/etc/rc.packages %%PORTNAME%% ${2}
