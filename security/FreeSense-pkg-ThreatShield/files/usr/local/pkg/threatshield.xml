<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE packagegui SYSTEM "../schema/packages.dtd">
<?xml-stylesheet type="text/xsl" href="../xsl/package.xsl"?>
<packagegui>
	<name>threatshield</name>
	<title>Services: Threat Shield</title>
	<donotsave>true</donotsave>
	<include_file>/usr/local/pkg/threatshield.inc</include_file>
	<menu>
		<name>Threat Shield</name>
		<tooltiptext>DNS ad and threat blocking, IP reputation and GeoIP country protection</tooltiptext>
		<section>Services</section>
		<group>security</group>
		<url>/threatshield/threatshield.php</url>
	</menu>
	<menu>
		<name>Threat Shield Status</name>
		<tooltiptext>Threat Shield health, statistics and query log</tooltiptext>
		<section>Status</section>
		<group>security</group>
		<url>/threatshield/threatshield_status.php</url>
	</menu>
	<menu>
		<name>Threat Map</name>
		<tooltiptext>Live map of blocked and allowed connections</tooltiptext>
		<section>Status</section>
		<group>security</group>
		<url>/threatshield/threatshield_map.php</url>
	</menu>
	<service>
		<name>threatshield</name>
		<rcfile>threatshield</rcfile>
		<executable>AdGuardHome</executable>
		<startcmd>mwexec('/usr/local/etc/rc.d/threatshield onestart');</startcmd>
		<stopcmd>mwexec('/usr/local/etc/rc.d/threatshield onestop');</stopcmd>
		<restartcmd>mwexec('/usr/local/etc/rc.d/threatshield onerestart');</restartcmd>
		<description>FreeSense Threat Shield DNS filter</description>
		<starts_on_sync></starts_on_sync>
	</service>
	<service>
		<name>threatshield_dnsbl</name>
		<rcfile>threatshield_dnsbl</rcfile>
		<executable>php</executable>
		<custom_php_service_status_command>is_pid_running('/var/run/threatshield_dnsbl.pid')</custom_php_service_status_command>
		<startcmd>mwexec('/usr/local/etc/rc.d/threatshield_dnsbl onestart');</startcmd>
		<stopcmd>mwexec('/usr/local/etc/rc.d/threatshield_dnsbl onestop');</stopcmd>
		<restartcmd>mwexec('/usr/local/etc/rc.d/threatshield_dnsbl onerestart');</restartcmd>
		<description>FreeSense Threat Shield inbound reputation checks</description>
		<starts_on_sync></starts_on_sync>
	</service>
	<plugins>
		<item><type>plugin_xmlrpc_send</type></item>
		<item><type>plugin_xmlrpc_recv</type></item>
		<item><type>plugin_xmlrpc_recv_done</type></item>
	</plugins>
	<filter_rules_needed>threatshield_generate_rules</filter_rules_needed>
	<custom_php_resync_config_command>threatshield_sync_config();</custom_php_resync_config_command>
	<custom_php_pre_deinstall_command>threatshield_remove_config();</custom_php_pre_deinstall_command>
</packagegui>
